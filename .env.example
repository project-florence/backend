ENVIRONMENT=production
FREE_CREDIT_MAX=25
DAILY_FREE_CREDIT_REFILL=5
LOG_DIR=/var/log/florence

GOOGLE_APPLICATION_CREDENTIALS="path/to/your-service-account.json"
COLLECT_API_KEY=your_collect_api_key
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_USER=postgres
POSTGRES_DB=postgres
SECRET_KEY=your_jwt_secret_key
ADMIN_TOKEN=your_admin_secret_token
REDIS_PASSWORD=your_redis_password
SEARXNG_SECRET_KEY=your_searxng_secret_key
FRED_API_KEY="your_fred_api_key"
EVDS_API_KEY="your_evds_api_key"
OPENROUTER_API_KEY="«redacted:sk-…»"
CUSTOM_API_KEY="your-custom-api-key"

# Ports
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
REDIS_HOST=localhost
REDIS_PORT=5434
REDIS_DB=0
REDIS_DECODE_RESPONSES=true
SEARXNG_HOST_PORT=5435
API_HOST_PORT=7055

# Embedding
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=mxbai-embed-large

# LLM
OPENROUTER_URL=https://openrouter.ai/api/v1
CUSTOM_URL=http://localhost:7777/v1
CUSTOM_MODEL=gemma

# News search
NEWS_SEARCH_URL=http://localhost:5435/search
NEWS_SEARCH_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"

# Portfolio
PORTFOLIO_COMMISSION_RATE=0.001

LOGODEV_API_KEY="your-api-key"

# ---------------------------------------------------------------------------
# Config (get_config() varsayilanlarini override eder). Semasi: <SECTION>_<KEY>
# (eski config.toml bölüm.anahtar karsiligi). Tümü istege baglidir; yoksa
# src/core/config.py icindeki varsayilanlar kullanilir.
# ---------------------------------------------------------------------------
COMPANY_INFO_CACHE_TTL=86400
COMPANY_INFO_REQUEST_DELAY_MIN=0.5
COMPANY_INFO_REQUEST_DELAY_MAX=1.5
COMPANY_INFO_BATCH_SIZE=10
COMPANY_INFO_BATCH_DELAY=5
COMPANY_INFO_MAX_RETRIES=3
COMPANY_INFO_RETRY_SLEEP_MIN=1
COMPANY_INFO_RETRY_SLEEP_MAX=3

ARTICLE_ANALYZER_QUICK_REPORT_ARTICLE_LIMIT=10
ARTICLE_ANALYZER_DEEP_REPORT_ARTICLE_LIMIT=100

GDELT_API_MAX_RECORDS=250
GDELT_API_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_API_MODE=ArtList
GDELT_API_FORMAT=json
GDELT_API_TIMEOUT=30

ARTICLE_COLLECTOR_BIGQUERY_PROJECT=project-florence-1
ARTICLE_COLLECTOR_DEFAULT_LIMIT=100
ARTICLE_COLLECTOR_GDELT_GQG_TABLE=gdelt-bq.gdeltv2.gqg
ARTICLE_COLLECTOR_GDELT_GKG_TABLE=gdelt-bq.gdeltv2.gkg_partitioned
ARTICLE_COLLECTOR_CACHE_TTL=3600

GET_BIST_COMPANIES_CACHE_INTERVAL=2592000

LLM_CLIENT_TYPE=custom
LLM_CLIENT_OPENROUTER_URL=https://openrouter.ai/api/v1
LLM_CLIENT_CUSTOM_URL=http://localhost:7777/v1
LLM_CLIENT_CUSTOM_MODEL=gemma

GENERATE_BIST_MAPPING_SCRAPE_URL=https://borsacoo.com/firmalar
GENERATE_BIST_MAPPING_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"
GENERATE_BIST_MAPPING_TIMEOUT=30
GENERATE_BIST_MAPPING_OUTPUT_DIR=data
GENERATE_BIST_MAPPING_OUTPUT_FILENAME=bist_companies.json

PRICE_HISTORY_RATE_LIMIT_DELAY=1.5
PRICE_HISTORY_CACHE_TTL=60
PRICE_HISTORY_CACHE_TTL_HOT=604800
PRICE_HISTORY_CACHE_TTL_INTRADAY=30
PRICE_HISTORY_STALE_TTL=30

ECONOMY_API_URL=https://api.genelpara.com/json/
ECONOMY_CACHE_TTL=1200

HALKARZ_BASE_URL=https://halkarz.com
HALKARZ_WP_API=https://halkarz.com/wp-json/wp/v2/posts
HALKARZ_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
HALKARZ_LIST_CACHE_TTL=3600
HALKARZ_DETAIL_CACHE_TTL=3600

REPORT_TOKEN_COST_PER_1K=0.05
REPORT_QUICK_REPORT_MAX_TOKENS=5000
REPORT_DEEP_REPORT_MAX_TOKENS=50000

SIMULATION_PER_DAY_COST=0.005

STOCK_VECTOR_TTL=86400
# Ic ice map'ler JSON string olarak override edilebilir:
# STOCK_VECTOR_RISK_TOLERANCE_MAP={"low": 0.10, "medium": 0.50, "high": 0.90}
# STOCK_VECTOR_HORIZON_MAP={"short": 0.15, "medium": 0.40, "long": 0.70}
# STOCK_VECTOR_PROFITABILITY_MAP={"low": 0.10, "medium": 0.35, "high": 0.70}

MACROECONOMY_CACHE_TTL=86400

# ---------------------------------------------------------------------------
# E-posta (MAIL_PROVIDER: smtp | mailpit | resend | ses)
# Varsayilan provider: resend (RESEND_API_KEY gerekli)
# mailpit (dev/UI): docker compose --profile dev up -d mailpit -> http://localhost:8025
# ---------------------------------------------------------------------------
MAIL_PROVIDER=resend
MAIL_FROM=support@florencex.com.tr
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
RESEND_API_KEY=
# E-posta dogrulama baglantisinda kullanilacak public taban URL
PUBLIC_BASE_URL=http://localhost:7055

# Veri disa aktarim (export) e-postalari icin ayri gonderici (yoksa MAIL_FROM kullanilir)
MAIL_EXPORT_FROM=data@florencex.com.tr
